# 실험 C(H2 인메모리) 재현용 예시. src/test/resources/application.yml 로 두면 된다.
# 실제 파일은 gitignore 대상이므로 시크릿은 마스킹했다.
# 실험 C: 2024년 조건 재현 — H2 인메모리
spring:
  datasource:
    driver-class-name: org.h2.Driver
    url: jdbc:h2:mem:test;DB_CLOSE_DELAY=-1
    username: sa
    password:
    hikari:
      maximum-pool-size: 100
  jpa:
    hibernate:
      ddl-auto: create
  data:
    redis:
      host: 127.0.0.1
      port: 6379

logging:
  level:
    root: warn

auth:
  jwt:
    issuer: team.sparta.com
    secret: <JWT_SECRET_그대로_넣을_것>
    accessTokenExpirationHour: 24
    refreshTokenExpirationHour: 168

bench:
  user-size: 10
  coupon-quantity: 10
  token-file: bench-out/ignore.txt
